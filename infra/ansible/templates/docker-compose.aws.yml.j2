services:
  db:
    image: postgres:15
    environment:
      POSTGRES_DB: vulndb
      POSTGRES_USER: vulnuser
      POSTGRES_PASSWORD: vulnpassword
    volumes:
      - pgdata:/var/lib/postgresql/data
    # Intentionally not published on the host. Reachable only on the Docker network.
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U vulnuser -d vulndb"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 10s

  keycloak:
    image: quay.io/keycloak/keycloak:26.6.1
    command:
      - "start-dev"
      - "--import-realm"
      # Use the Docker-network hostname so the OIDC discovery issuer matches what
      # Spring is configured with. Browser HTML login via the public IP may need
      # extra Keycloak hostname config later; API scanning does not.
      - "--hostname=http://keycloak:8080"
      - "--hostname-strict=false"
      - "--http-enabled=true"
    environment:
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: admin
    volumes:
      - ./realm-full-export.json:/opt/keycloak/data/import/realm-full-export.json
    ports:
      - "{{ keycloak_port }}:8080"
    restart: unless-stopped

  app:
    build: ./app
    # Skip the image's local-dev sleep; Ansible waits for readiness instead.
    entrypoint: ["java", "-jar", "/app/app.jar"]
    ports:
      - "{{ app_port }}:8081"
    depends_on:
      db:
        condition: service_healthy
      keycloak:
        condition: service_started
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      SPRING_PROFILES_ACTIVE: docker
      # Must match Keycloak's discovery "issuer" (see hostname above). Do not use
      # the public EIP here: EC2 hairpin NAT is unreliable and Spring fails startup
      # when the configured issuer-uri does not match the discovery document.
      SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_KEYCLOAK_ISSUER_URI: "http://keycloak:8080/realms/test-realm"
      # Give the JVM a bit more room on t3.small alongside Keycloak + Postgres.
      JAVA_TOOL_OPTIONS: "-Xms256m -Xmx512m"
    restart: unless-stopped

volumes:
  pgdata:
